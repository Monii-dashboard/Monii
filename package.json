{
  "name": "monii",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @monii/web dev",
    "build": "pnpm graphql:check && pnpm --filter @monii/web build",
    "start": "pnpm --filter @monii/web start",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @monii/runtime typecheck && pnpm --filter @monii/application typecheck && pnpm --filter @monii/server typecheck && pnpm --filter @monii/cli typecheck && pnpm --filter @monii/console typecheck && pnpm --filter @monii/web typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "cli": "pnpm --filter @monii/cli cli",
    "console": "pnpm --filter @monii/console console",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "graphql:generate": "graphql-codegen --config codegen.ts",
    "graphql:check": "graphql-codegen --config codegen.ts --check"
  },
  "devDependencies": {
    "@apollo/client": "4.1.9",
    "@graphql-codegen/cli": "^7.1.3",
    "@graphql-codegen/client-preset": "^6.0.1",
    "@graphql-codegen/schema-ast": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.5",
    "@graphql-eslint/eslint-plugin": "^4.4.1",
    "@graphql-typed-document-node/core": "3.2.0",
    "@monii/runtime": "workspace:*",
    "@monii/server": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "class-validator": "^0.14.4",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "graphql": "16.12.0",
    "graphql-config": "^5.1.6",
    "graphql-scalars": "1.25.0",
    "reflect-metadata": "0.2.2",
    "react": "19.2.8",
    "rxjs": "7.8.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "type-graphql": "2.0.0-rc.4",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@11.23.0"
}
